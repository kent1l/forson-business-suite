# PostgreSQL Database Connection
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secret_password_here
DB_NAME=forson_business_suite

# JWT Secret for Authentication
JWT_SECRET=a_very_long_and_random_string_for_security

# Backup Configuration
BACKUP_RETENTION_DAYS=7

# Meilisearch Configuration
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_MASTER_KEY=another_strong_and_secret_key

# --- Meilisearch Advanced Configuration ---
# Set the environment: development, staging, or production
NODE_ENV=development

# Disable durable outbox worker for parts sync (debugging only)
DISABLE_MEILI_OUTBOX_WORKER=false

# Disable applications LISTEN/NOTIFY index sync listener (debugging only)
DISABLE_MEILI_APPLICATIONS_LISTENER=false

# Enable legacy parts LISTEN/NOTIFY listener (normally false when outbox worker is enabled)
ENABLE_LEGACY_MEILI_PART_LISTENER=false

# Retry logic for Meilisearch setup (optional, defaults shown)
MEILI_SETUP_MAX_RETRIES=4
MEILI_SETUP_RETRY_DELAY=200

# Typo tolerance configuration (optional, defaults shown)
MEILI_TYPO_ENABLED=true
MEILI_TYPO_MIN_WORD_SIZE=4
MEILI_TYPO_MIN_WORD_SIZE_TWO=8

# See MEILISEARCH_CONFIG.md for more details on these options and recommended values for each environment.

# --- AI Task-Specific Model Pool Architecture ---
# Declarative model pools and provider fallback chains are configured in packages/api/config/ai-models.yaml
# Model pools may cascade across configured provider keys (Gemini, Groq,
# OpenRouter, and direct DeepSeek) according to ai-models.yaml.

# Google Gemini Credentials (Single key or comma-separated rotational key pool)
GEMINI_API_KEY=
GEMINI_API_KEY_POOL=

# Groq API Credentials
GROQ_API_KEY=

# OpenRouter API Credentials
OPENROUTER_API_KEY=

# Direct DeepSeek Credentials (used for scheduled paid bulk processing and
# the final interactive paid fallback; configure this with a real key locally)
DEEPSEEK_API_KEY=

# TypeSafe AI Jev via OpenRouter Decisions API (optional). Reuses
# OPENROUTER_API_KEY above; without it, duplicate scans use local PostgreSQL
# trigram matching only.
OPENROUTER_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions
JEV_MODEL=typesafe/jev-1.13
JEV_TIMEOUT_MS=3500
JEV_DUPLICATE_THRESHOLD=0.80
JEV_ENABLED=true

# Paperless-ngx Integration
PAPERLESS_API_URL=https://paperless.example.com/api
PAPERLESS_API_TOKEN=your_paperless_api_token_here
PAPERLESS_TIMEOUT_SECONDS=30
PAPERLESS_VERIFY_SSL=true
